<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LockPad</AssemblyName>
    <RootNamespace>LockPad.App</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>Assets\LockPad.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- ApplicationIcon gives the exe its icon; the Resource copy is the windows' title-bar and taskbar icon. -->
    <Resource Include="Assets\LockPad.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LockPad.Core\LockPad.Core.csproj" />
    <InternalsVisibleTo Include="LockPad.Tests" />
  </ItemGroup>
</Project>