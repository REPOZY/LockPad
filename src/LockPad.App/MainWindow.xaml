<Window x:Class="LockPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LockPad.App.ViewModels"
        xmlns:views="clr-namespace:LockPad.App.Views"
        Title="{Binding WindowTitle, FallbackValue=LockPad}" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="/LockPad;component/Assets/LockPad.ico"
        Background="{DynamicResource WindowBackground}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown"
        PreviewMouseMove="OnPreviewMouseMove" PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
        <!-- Every page is hosted here; unlock, create and the editor never open a separate window. -->
        <DataTemplate DataType="{x:Type vm:UnlockViewModel}">
            <views:UnlockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateNotebookViewModel}">
            <views:CreateNotebookView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
    </Window.Resources>
    <!-- Editor shortcuts live on the window so they keep working wherever focus is (e.g. after a delete disables
         the editor). They are inert while Editor is null: the bound command is then null. Del stays on the notes
         list only; Ctrl+F is handled below. Ctrl+L (lock) is handled in OnPreviewKeyDown so no control can swallow it. -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding Editor.NewNoteCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Editor.SaveCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding Editor.SaveAsCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="F2" Command="{Binding Editor.RenameNoteCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding Editor.ZoomInCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding Editor.ZoomInCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding Editor.ZoomOutCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding Editor.ZoomOutCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding Editor.ZoomResetCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding Editor.ZoomResetCommand, FallbackValue={x:Null}}" />
        <KeyBinding Key="Z" Modifiers="Alt" Command="{Binding Editor.ToggleWordWrapCommand, FallbackValue={x:Null}}" />
        <!-- F1 works on every page (unlock, create, editor): it is bound to the shell, not to the editor. -->
        <KeyBinding Key="F1" Command="{Binding OpenShortcutsCommand}" />
        <!-- Ctrl+O (File > Open notebook) is bound to the shell: it works on the editor and the plain unlock page. -->
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenNotebookCommand}" />
    </Window.InputBindings>
    <!-- Ctrl+F is ApplicationCommands.Find's default gesture; handled here so it works wherever focus is. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" CanExecute="OnFindCanExecute" />
    </Window.CommandBindings>
    <DockPanel>
        <!-- The menu bar, its drop-down, separators and gesture texts are styled by Themes/Controls.xaml (implicit
             styles, so no item has a Style of its own); in Windows high contrast the system menu styles render. -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <!-- Access keys in File: New notebook N, Open notebook O, Save S, Save As A, Change master password C, Lock L,
                 Exit x. -->
            <MenuItem x:Name="FileMenu" Header="_File">
                <!-- New / Open notebook: on the editor (the current notebook is closed first, like closing the window:
                     saved, or the user is asked) and on the plain unlock page; never on the held unlock page or the
                     create page, while a page is busy, while the editor is obscured, or during a dialog or a save. -->
                <MenuItem x:Name="NewNotebookMenuItem" Header="_New notebook&#x2026;"
                          Command="{Binding NewNotebookCommand}" />
                <MenuItem x:Name="OpenNotebookMenuItem" Header="_Open notebook&#x2026;" InputGestureText="Ctrl+O"
                          Command="{Binding OpenNotebookCommand}" />
                <Separator />
                <!-- Save, Save As, Change master password and Lock: only while the editor is shown (IsEditorShown). -->
                <MenuItem x:Name="SaveMenuItem" Header="_Save" InputGestureText="Ctrl+S"
                          IsEnabled="{Binding IsEditorShown, FallbackValue=False}"
                          Command="{Binding Editor.SaveCommand, FallbackValue={x:Null}}" />
                <!-- Save As is also offered here so the way out of a lasting save failure is visible (Ctrl+Shift+S). It
                     is bound to the editor's existing command and disabled while no editor is shown. -->
                <MenuItem x:Name="SaveAsMenuItem" Header="Save _As&#x2026;" InputGestureText="Ctrl+Shift+S"
                          ToolTip="Save As (Ctrl+Shift+S)" ToolTipService.ShowOnDisabled="True"
                          IsEnabled="{Binding IsEditorShown, FallbackValue=False}"
                          Command="{Binding Editor.SaveAsCommand, FallbackValue={x:Null}}" />
                <Separator />
                <!-- No shortcut. Disabled while no editor is shown (locked) and, through the command, for a read-only
                     notebook and while the editor is obscured. -->
                <MenuItem x:Name="ChangePasswordMenuItem" Header="_Change master password&#x2026;"
                          IsEnabled="{Binding IsEditorShown, FallbackValue=False}"
                          Command="{Binding Editor.ChangePasswordCommand, FallbackValue={x:Null}}" />
                <Separator />
                <!-- The same as Ctrl+L (handled in OnPreviewKeyDown). -->
                <MenuItem x:Name="LockMenuItem" Header="_Lock" InputGestureText="Ctrl+L"
                          IsEnabled="{Binding IsEditorShown, FallbackValue=False}" Command="{Binding LockCommand}" />
                <Separator />
                <!-- Closes the window through the normal Closing path (save, or ask). -->
                <MenuItem x:Name="ExitMenuItem" Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <!-- Settings is a direct top-level item (no drop-down): a click opens the window. The theme is set only in
                 Settings (user decisions 2026-10-19). Access keys: File F, Settings S, Help H. -->
            <MenuItem Header="_Settings" Command="{Binding OpenSettingsCommand}" />
            <!-- Help (user decision 2026-10-21; Shortcuts was a direct top-level item before): both items work on every
                 page, like F1. Access keys: Keyboard shortcuts K, About A. -->
            <MenuItem x:Name="HelpMenu" Header="_Help">
                <MenuItem x:Name="ShortcutsMenuItem" Header="_Keyboard shortcuts" InputGestureText="F1"
                          Command="{Binding OpenShortcutsCommand}" />
                <MenuItem x:Name="AboutMenuItem" Header="_About LockPad&#x2026;" Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>
        <!-- Status bar: only while the editor is shown. -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource PanelBackground}"
                   Foreground="{DynamicResource EditorForeground}">
            <StatusBar.Style>
                <Style TargetType="StatusBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Editor}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StatusBar.Style>
            <StatusBarItem x:Name="LockCountdownItem" DockPanel.Dock="Right" Content="{Binding LockCountdownText}" />
            <StatusBarItem Content="{Binding Editor.StatusText}" />
        </StatusBar>
        <ContentControl Content="{Binding CurrentView}" Focusable="False" />
    </DockPanel>
</Window>
