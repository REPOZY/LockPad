<Window x:Class="LockPad.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change master password" SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/LockPad;component/Assets/LockPad.ico"
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1">
    <!-- The current password is required; only the password changes (the key file, if any, is kept). Passwords leave
         the boxes only as SecureString (code-behind), never through a binding. -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EditorForeground}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Secret" TargetType="PasswordBox">
            <Setter Property="Padding" Value="2" />
            <Setter Property="MaxLength" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EditorBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource EditorForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <!-- Caps Lock warning (fix round 2, X5): re-evaluated whenever focus enters or leaves a box and on every key
                 released in one (Caps Lock itself included). -->
            <EventSetter Event="GotKeyboardFocus" Handler="OnSecretFocusChanged" />
            <EventSetter Event="LostKeyboardFocus" Handler="OnSecretFocusChanged" />
            <EventSetter Event="KeyUp" Handler="OnSecretKeyUp" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock x:Name="CurrentLabel" Text="Current password" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <PasswordBox x:Name="CurrentInput" Style="{StaticResource Secret}" />

        <TextBlock x:Name="NewLabel" Text="New password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="NewInput" Style="{StaticResource Secret}" PasswordChanged="OnNewPasswordChanged" />
        <!-- The strength meter: an empty track and a hint until a character is typed, then a fill coloured by the
             rating (StrengthMeter in Themes/Controls.xaml) and the rating text. -->
        <ProgressBar x:Name="StrengthBar" Margin="0,6,0,0" Height="8" Minimum="0" Maximum="128"
                     Value="{Binding StrengthBits, Mode=OneWay}" Style="{DynamicResource StrengthMeter}" />
        <Grid Margin="0,4,0,0">
            <TextBlock x:Name="StrengthText" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPassword}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding Strength, Mode=OneWay}" />
                <Run Text="{Binding StrengthBits, Mode=OneWay, StringFormat='({0} bits)'}" />
                <Run Text="{Binding StrengthWarning, Mode=OneWay}" />
            </TextBlock>
            <TextBlock x:Name="StrengthHint" Text="Type a password to see its strength." TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForeground}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPassword}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock x:Name="RepeatLabel" Text="Repeat new password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="RepeatInput" Style="{StaticResource Secret}" />

        <TextBlock x:Name="CapsLockWarning" Margin="0,6,0,0" Text="Caps Lock is on." Visibility="Collapsed"
                   Foreground="{DynamicResource MutedForeground}" />
        <TextBlock x:Name="BackupNote" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                   Text="Changing the password saves your notebook. The backup file (.bak) will then hold your current notes, so notes you deleted can no longer be restored from it." />

        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ErrorForeground}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <!-- Disabled for the wait after a wrong current password (1, 2, 4, then 8 s; as on the held unlock), and for
                 good once the screen locked while the dialog was open (the change is refused then). -->
            <Button x:Name="ChangeButton" Content="Change password" MinWidth="120" Padding="8,2" IsDefault="True"
                    Margin="0,0,8,0" Click="OnChange" IsEnabled="{Binding CanChange}"
                    Style="{DynamicResource PrimaryButton}" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" Padding="8,2" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
