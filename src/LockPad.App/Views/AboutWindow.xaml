<Window x:Class="LockPad.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About LockPad" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/LockPad;component/Assets/LockPad.ico"
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1">
    <!-- The GitHub address is plain text plus a Copy link button: no hyperlink and no browser launch, so LockPad
         itself never connects to the internet. Close is both the default and the cancel button. -->
    <StackPanel Margin="16">
        <TextBlock Text="LockPad" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource EditorForeground}" />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EditorForeground}"
                   Text="An encrypted notepad. Each notebook is one KDBX 4.1 file (the KeePass format), locked with your master password." />
        <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource EditorForeground}"
                   Text="Documentation and source code:" />
        <TextBlock x:Name="UrlText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource EditorForeground}" />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                   Text="LockPad never connects to the internet. To visit the page, copy the address into your browser." />
        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                   Text="Free software under the GNU General Public License, version 2 or later. Uses KeePassLib 2.61.1, Copyright (C) 2003-2026 Dominik Reichl." />
        <DockPanel Margin="0,16,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyLinkButton" Content="_Copy link" MinWidth="90" Padding="8,2" Margin="0,0,8,0"
                        Click="OnCopyLink" />
                <Button x:Name="CloseButton" Content="Close" MinWidth="80" Padding="8,2" IsDefault="True" IsCancel="True" />
            </StackPanel>
            <!-- "Link copied." or the failure text; empty until Copy link is clicked. -->
            <TextBlock x:Name="CopyStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"
                       Foreground="{DynamicResource EditorForeground}" />
        </DockPanel>
    </StackPanel>
</Window>
