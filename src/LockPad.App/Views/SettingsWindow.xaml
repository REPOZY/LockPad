<Window x:Class="LockPad.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="Height" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/LockPad;component/Assets/LockPad.ico"
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EditorForeground}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="NumberField" TargetType="TextBox">
            <Setter Property="Padding" Value="2" />
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="Background" Value="{DynamicResource EditorBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource EditorForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock x:Name="IdleLockLabel" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                   Text="Lock after idle (minutes, 1&#x2013;60)" />
        <TextBox x:Name="IdleLockBox" Style="{StaticResource NumberField}"
                 Text="{Binding IdleLockMinutes, UpdateSourceTrigger=PropertyChanged}"
                 PreviewTextInput="OnNumberTextInput" PreviewKeyDown="OnNumberKeyDown"
                 DataObject.Pasting="OnNumberPaste" />

        <TextBlock x:Name="ClipboardLabel" Style="{StaticResource FieldLabel}"
                   Text="Clear clipboard after (seconds, 5&#x2013;120)" />
        <TextBox x:Name="ClipboardBox" Style="{StaticResource NumberField}"
                 Text="{Binding ClipboardClearSeconds, UpdateSourceTrigger=PropertyChanged}"
                 PreviewTextInput="OnNumberTextInput" PreviewKeyDown="OnNumberKeyDown"
                 DataObject.Pasting="OnNumberPaste" />

        <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="ThemeBox" SelectedItem="{Binding Theme}" />

        <!-- Capture protection (CaptureProtection; on by default). The note says honestly what it does not stop. -->
        <CheckBox x:Name="CaptureProtectionBox" Margin="0,16,0,0" Content="_Hide LockPad from screenshots and screen sharing"
                  IsChecked="{Binding HideFromScreenCapture}" />
        <TextBlock x:Name="CaptureProtectionNote" Margin="22,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForeground}"
                   Text="Turn off to take screenshots of LockPad yourself. It does not stop a phone camera or malware aimed at LockPad itself." />

        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource ErrorForeground}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" Margin="0,0,8,0" Click="OnOk"
                    Style="{DynamicResource PrimaryButton}" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
