<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="EditorBackground" Color="#FF171717" />
    <SolidColorBrush x:Key="EditorForeground" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="MutedForeground" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="ErrorForeground" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="WarningBackground" Color="#FF4A3F12" />
    <!-- The editor's selection, also while it is unfocused (find); drawn at the TextBox's SelectionOpacity (0.4). -->
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#FF4DA3FF" />
    <!-- The 1 px edge of every dialog: at least 3:1 against WindowBackground, PanelBackground and EditorBackground,
         so a dark dialog never blends into the dark main window behind it. -->
    <SolidColorBrush x:Key="DialogBorder" Color="#FF787878" />

    <!-- Control templates (Themes/Controls.xaml). Text pairs meet 4.5:1, the focus rectangle and the meter fills 3:1
         (ThemedControlsTests checks every pair). -->
    <SolidColorBrush x:Key="TransparentBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ControlBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#FF3E3E3E" />
    <SolidColorBrush x:Key="ControlPressedBackground" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="ControlBorder" Color="#FF858585" />
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="ControlDisabledBorder" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#FF959595" />
    <SolidColorBrush x:Key="DefaultButtonBorder" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="#FF0E639C" />
    <SolidColorBrush x:Key="PrimaryHoverBackground" Color="#FF1177BB" />
    <SolidColorBrush x:Key="PrimaryPressedBackground" Color="#FF0B4F7D" />
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PopupBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="PopupBorder" Color="#FF787878" />
    <SolidColorBrush x:Key="HighlightBackground" Color="#FF094771" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="ScrollBarTrack" Color="#FF252526" />
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#FF7E7E7E" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#FFA6A6A6" />
    <SolidColorBrush x:Key="ScrollBarArrow" Color="#FFA6A6A6" />
    <SolidColorBrush x:Key="ProgressTrack" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="ProgressFill" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="StrengthWeakBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="StrengthFairBrush" Color="#FFFFB900" />
    <SolidColorBrush x:Key="StrengthStrongBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="ToolTipBorder" Color="#FF787878" />
</ResourceDictionary>
