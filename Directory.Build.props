<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <!-- Restore checks every package against the committed packages.lock.json files (content hashes). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Restore fails if a package differs from the lock files. To change a package, restore with the force-evaluate option and commit the new lock files. -->
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="[1.0.3]" PrivateAssets="all" />
  </ItemGroup>
</Project>